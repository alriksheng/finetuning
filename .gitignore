!/data/eval/
!/data/train/
!/data/tokenizer/
!/data/train_final/
!/data/splits_final.yaml
!/data/train_B/
!/data/splits_B.yaml
!/data/train_c25/
!/data/train_c50/
!/data/splits_c25.yaml
!/data/splits_c50.yaml
!/data/splits_fix.yaml
!/data/fix/
!/data/out_fix/
!/data/train_fix/
